---
import Layout from '../layouts/Layout.astro';
import PrecisionDemo from '../components/PrecisionDemo.vue';
import ExpressionEvaluator from '../components/ExpressionEvaluator.vue';
---

<Layout>
  <div class="min-h-screen bg-slate-50 selection:bg-teal-100 selection:text-teal-900 overflow-hidden relative">
    
    <!-- Background Decorators -->
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-[25%] -left-[10%] w-[50%] h-[50%] rounded-full bg-gradient-to-br from-teal-100/40 to-transparent blur-3xl"></div>
      <div class="absolute top-[20%] -right-[10%] w-[40%] h-[60%] rounded-full bg-gradient-to-bl from-slate-200/40 to-transparent blur-3xl"></div>
    </div>

    <!-- Navigation -->
    <nav class="relative z-10 max-w-5xl mx-auto px-6 py-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/logo.png" alt="PrecisionJS Logo" class="h-8 object-contain" />
      </div>
      <div class="flex items-center gap-6 text-sm font-medium text-slate-600">
        <a href="https://github.com/jaiko86/precisionjs" target="_blank" class="hover:text-slate-900 transition-colors">GitHub</a>
        <a href="#demo" class="hover:text-slate-900 transition-colors">Demo</a>
      </div>
    </nav>

    <!-- Hero Section -->
    <main class="relative z-10 max-w-5xl mx-auto px-6 pt-20 pb-32">
      <div class="max-w-3xl text-center mx-auto">
        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight text-slate-900 mb-8 leading-[1.15]">
          Arbitrary-precision math for modern JavaScript.
        </h1>
        <p class="text-xl text-slate-600 mb-12 leading-relaxed max-w-2xl mx-auto">
          Evaluate complex expressions, handle infinite precision, and eliminate native floating-point errors completely. Zero dependencies.
        </p>
        <div class="flex items-center justify-center gap-4">
          <a href="https://github.com/jaiko86/precisionjs" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-teal-600 hover:bg-teal-700 shadow-sm transition-all hover:shadow hover:-translate-y-0.5">
            View on GitHub
          </a>
          <a href="#demo" class="inline-flex items-center justify-center px-6 py-3 border border-slate-200 text-base font-medium rounded-xl text-slate-700 bg-white hover:bg-slate-50 shadow-sm transition-all hover:shadow hover:-translate-y-0.5">
            Try Interactive Demo
          </a>
        </div>
      </div>
      
      <!-- Terminal Install Box -->
      <div class="mt-16 max-w-lg mx-auto">
        <div class="bg-slate-900 rounded-2xl shadow-2xl p-4 flex items-center justify-between group cursor-copy">
          <div class="flex items-center gap-4 font-mono text-sm">
            <span class="text-teal-400 select-none">$</span>
            <span class="text-slate-300">npm install precisionjs</span>
          </div>
          <svg class="w-5 h-5 text-slate-500 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
        </div>
      </div>
    </main>

    <!-- Interactive Demos Section -->
    <section id="demo" class="relative z-10 border-t border-slate-200 bg-white py-24">
      <div class="max-w-5xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Interactive Playground</h2>
          <p class="mt-4 text-lg text-slate-500">Test the lexer, parser, and arbitrary-precision evaluator directly in your browser.</p>
        </div>

        <PrecisionDemo client:load />
        
        <div class="mt-16"></div>
        
        <ExpressionEvaluator client:load />
      </div>
    </section>
    
    <footer class="border-t border-slate-100 bg-slate-50 py-12">
      <div class="max-w-5xl mx-auto px-6 text-center text-sm text-slate-500 font-medium">
        Built with Astro, Vue & Tailwind CSS. Designed for precisionjs.
      </div>
    </footer>
  </div>
</Layout>
